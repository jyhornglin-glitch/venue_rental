# Django 系統安全性設定
SECRET_KEY=your-secret-key-here-please-change-in-production
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,your-nas-domain.synology.me,192.168.1.100

# 反向代理與 CSRF 信任來源（開頭必須帶 http:// 或 https://，若有多個以逗點隔開）
CSRF_TRUSTED_ORIGINS=https://your-nas-domain.synology.me,http://192.168.1.100:8000,http://127.0.0.1:8000

# 資料庫切換開關 (預設為 False 使用 SQLite，若要切換至 MariaDB 請設為 True)
USE_MARIADB=False

# MariaDB / MySQL 連線設定 (當 USE_MARIADB=True 時生效)
# 注意：Synology NAS 的 MariaDB 10 預設連接埠通常為 3307，請依實際設定填寫
DB_NAME=venue_db
DB_USER=venue_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3307

