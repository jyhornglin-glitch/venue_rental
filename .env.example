# Django 系統安全性設定
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,your-nas-domain.synology.me

# 資料庫切換開關 (預設為 False 使用 SQLite，若要切換至 MariaDB 請設為 True)
USE_MARIADB=False

# MariaDB / MySQL 連線設定 (當 USE_MARIADB=True 時生效)
DB_NAME=venue_db
DB_USER=venue_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=3306
